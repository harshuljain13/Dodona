# Dodona — copy to .env and fill in. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# Sourced by infra/cluster/setup/up.sh, sync.sh and tunnel.sh from the project
# root, and exported into your shell before running the control plane.

# ---- the box -----------------------------------------------------------------
# Any machine with an NVIDIA card that you can ssh to AND have root on. Nothing
# here is provider-specific — these three values are the entire contract.
#
#   Lambda / EC2 / bare metal   BOX=ubuntu@203.0.113.4        SSH_PORT=22
#   RunPod                      BOX=root@194.26.196.4         SSH_PORT=22122
#
# RunPod gives you a high port rather than 22; copy both from the pod's
# "Direct TCP" connect string. Its ssh.runpod.io proxy is NOT usable here — it
# forwards no ports, and `make ssh` is nine port-forwards.
#
# ⚠ A standard RunPod *Pod* is a container: no systemd and no privileged
# kernel access, so `curl get.k3s.io | sh` cannot install the k3s service and
# HAMi cannot slice the card. For this project RunPod must be an Instant
# Cluster / bare-metal host, where you get the machine rather than a container
# on it. See WORKSHOP.md.
export BOX=ubuntu@YOUR_BOX_IP
export SSH_KEY=$HOME/.ssh/dodona_ed25519
export SSH_PORT=22

# ---- the model ---------------------------------------------------------------
# Pulling the weights onto the box. Without it `make cluster` gets a 401 part
# way into the download, reported by huggingface rather than by us — which
# reads as a network problem rather than a missing token.
export HF_TOKEN=

# Pick one. The model is not a taste question here — it sets KV bytes per token,
# which sets how many sessions fill a card, which is what decides whether the
# admission policy can fire at all.
#
# KV bytes/token = 2 (K+V) x layers x kv_heads x head_dim x 2 (fp16). Firm, from
# each model's config.json. Weights and sessions are PREDICTED until a run
# measures them.
#
#   model            layers  kv_heads  KV/token   weights(int4)  KV on 80 GiB
#   Qwen2.5-7B-AWQ       28         4     56 KiB      ~5.2 GiB      ~66.8 GiB
#   Qwen2.5-32B-AWQ      64         8    256 KiB     ~19.5 GiB      ~52.5 GiB
#   Qwen2.5-72B-AWQ      80         8    320 KiB       ~41 GiB        ~31 GiB
#
# What that means for a 12k-token prompt (one fetched source, ~12.4k with the
# answer), on ONE A100-80GB at utilisation 0.90:
#
#   7B    ~100 concurrent sessions to reach kv_cache_usage 0.90   hard to drive
#   32B    ~17 concurrent sessions                                 comfortable
#   72B     ~8 concurrent sessions                                 easiest
#
# A model too small for the card is the INERT trap: the pool never fills, the
# policy never fires, and the run's numbers are indistinguishable from having no
# policy. Either move up a size, or cap the worker with SLICE_MIB below.
#
# int4 is forced, not chosen: the A100 is sm80 and has no fp8 tensor cores. It
# also buys the KV room — a 32B in fp16 is ~60 GiB of weights and leaves barely
# 11 GiB of cache. See docs/project/01-capacity.md.
export LOCAL_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
export TEXT_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
# export LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ    # 1 small card, or 3 sharing one
# export TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# The vision alias is unused — kept so the guardrail allowlist stays intact.
export VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ---- the fleet ---------------------------------------------------------------
# One prefill, two decode, wherever they run. Two decode workers is the minimum
# for pick() to be a real decision rather than routing.
#
#   make cluster   three HAMi slices of one card, the URLs below unused —
#                  the gateway pod is given Service names instead
#   make workers   one worker per GPU, these URLs, set by the launcher
export PREFILL_URLS=http://127.0.0.1:8000
export DECODE_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002
export LOCAL_BASE_URL=http://127.0.0.1:8000/v1

export LAB_TOPOLOGY=disaggregated

# Where the three workers listen: PORT_BASE, +1, +2. Only `make workers` reads
# it. A rented box is not empty — RunPod's Jupyter template runs nginx on
# :8001, which is decode-0's port by default. vLLM then fails with "Address
# already in use" while a health check on that port succeeds, because nginx is
# answering it.
#
# `make workers` checks before starting anything and names what is in the way.
# If it does, move the block:  PORT_BASE=8100 make workers
export PORT_BASE=8000

# How much GPU memory ONE worker may hold, in MiB. Only `make workers` reads it;
# the Kubernetes path gets the same figure from HAMi's `gpumem: 12288`.
#
#   0  = take the whole card. Right when each worker has its own GPU.
#   N  = cap at N MiB. For workers SHARING a card, or a model small enough that
#        a whole card gives it a KV pool the policy can never fill.
#
# Both mistakes are quiet, and in opposite directions:
#
#   too high  0.90 of an 80 GiB card with a 7B is a ~66 GiB KV pool.
#             kv_cache_usage_perc never reaches 0.90, the policy cannot fire,
#             and every run comes back INERT — indistinguishable from no policy.
#   too low   12 GiB with a 32B is less than the weights. vLLM will not start.
#
# 3 x A100-80GB, one worker each, 32B          ->  0      (nothing to slice)
# 1 x A100-80GB, one worker, 7B                ->  12288  (or the pool never fills)
# 1 x A100-40GB, three workers sharing it, 7B  ->  12288
export SLICE_MIB=0
export LAB_SPLIT=capability

# ---- the hop -----------------------------------------------------------------
# mooncake is the only backend that moves bytes. router/nccl.py and
# router/nixl.py return immediately without transferring anything, so an empty
# /hops panel under those means nothing at all — check this value first.
export KV_BACKEND=mooncake
export MOONCAKE_URL=http://127.0.0.1:50051

# ---- the control plane -------------------------------------------------------
export ORCH_URL=http://127.0.0.1:8080/v1
export LOCUST_HOST=http://127.0.0.1:8080

# Admission is a socket. Leave ADMISSION_POLICY unset and the gate is off and
# the gateway keeps its own behaviour — but then nothing is logged, so there is
# no baseline to compare against. Use no_admission for the baseline instead.
export ADMISSION_POLICY=kv_threshold
export ADMISSION_THRESHOLD=0.90
export ADMISSION_EXPERIMENT=dodona
export ADMISSION_RUN=r1
export ADMISSION_LOG=metrics/r1/decisions.jsonl

# ---- overflow ----------------------------------------------------------------
# 503 and 529 only. A 429 is client-attributable and must never leave: paying a
# provider for a request we are refusing on quota grounds is overspending, not a
# capacity event.
#
# A 4B answering for a 7B is a relief valve, NOT equivalent service — overflowed
# responses are never pooled with local ones when reporting quality.
#
# OVERFLOW_MAX_REQS is a LIFETIME cap on the gateway process, not a rate. After
# 20 the path switches itself off, which can look like "overflow did not help"
# when what happened is that overflow stopped being available. Say so in the run
# summary.
export OVERFLOW_BACKEND=superlinked
export OVERFLOW_BASE_URL=https://api.superlinked.com/v1
export OVERFLOW_MODEL=Qwen/Qwen3.5-4B
export OVERFLOW_API_KEY=
export OVERFLOW_MAX_TOKENS=64
export OVERFLOW_MAX_REQS=20

# ---- the app -----------------------------------------------------------------
export DEEPGRAM_API_KEY=
# What `web_search` and `scrape_url` read. One key covers both tools: Firecrawl
# backs the search AND the fetch, which is why it is the only one here. (A Brave
# key, if one is set, takes over search only — leaving scrape_url still on
# Firecrawl. Half a provider is not worth a second account.)
#
# Without it both tools fail and the agent answers from memory while sounding
# exactly as confident — so it reads as a model that hallucinates rather than as
# a missing key.
export FIRECRAWL_API_KEY=

# ---- the agent's own traces (optional) ---------------------------------------
# AgentShip builds a span tree for every turn whether or not anything collects
# it. Unset, the tree ships NOWHERE and the run never dials out — so leaving
# this block blank is a working configuration, not a degraded one.
#
# Filling it in sends spans to Comet/Opik, which is off this machine. That is a
# deliberate exception to the rule the rest of this project keeps — only the
# completion leaves — so it is opt-in twice: once by naming an exporter, and
# again by ALLOW_SAAS. Useful on the presenter's laptop to show the agent's span
# tree beside Grafana; not something to ask a room to configure.
#
# `capture_content` stays false by default, so prompts and responses are not put
# on spans even when this is on. Turning it on sends what people said to a
# third party.
export AGENTSHIP_OTEL_EXPORTERS=
export AGENTSHIP_OTEL_ALLOW_SAAS=
export OPIK_API_KEY=
export OPIK_WORKSPACE=
export OPIK_PROJECT_NAME=
export OPIK_OTEL_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel/v1/traces

# ---- traces ------------------------------------------------------------------
export TRACE_PATH=metrics/traces/requests.jsonl
