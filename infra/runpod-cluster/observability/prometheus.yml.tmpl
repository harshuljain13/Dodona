# Prometheus for the no-orchestrator path — `make workers`.
#
# The Kubernetes path discovers targets: a ServiceMonitor matches pods by label
# and the list changes as KEDA scales. There is nothing to discover here, so
# workers.sh renders __VLLM_TARGETS__ from the fleet it actually started — one
# entry per worker, on the ports that run, with the `pod` name pools.py gave it.
#
# Hardcoding three was wrong twice over: the count follows the card count now,
# and the roles follow LAB_TOPOLOGY. `phase` is prefill/decode when the pools
# are split and `both` when every engine serves both phases, which is the
# honest label for the aggregated default — calling a full engine "decode"
# to keep a dashboard panel company is how a graph starts lying.
#
# The admission policy does NOT read these labels: it reads each worker's
# /metrics directly through `VLLMWorker.snapshot`, so a mislabelled target
# costs you a confusing dashboard, not a wrong decision.

global:
  scrape_interval: 5s      # admission decides on seconds; a 15s default would
  evaluation_interval: 5s  # smooth away the spike the whole experiment is about

scrape_configs:
  - job_name: vllm
    metrics_path: /metrics
    static_configs:
__VLLM_TARGETS__

  # guard / admit / place / queue counters, and the decision log's gate series.
  - job_name: gateway
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:8080"]
        labels: { job_role: control-plane }

  # The hop ledger: count, tokens, bytes. Flat zero here is the honest answer
  # when decode re-prefills, which it does.
  - job_name: mooncake
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:50051"]

  # GPU utilisation, memory, power and temperature, under the DCGM_FI_DEV_*
  # names dashboards.py queries. The k8s path gets them from a dcgm-exporter
  # DaemonSet; here infra/runpod-cluster/observability/gpu_exporter.py reads the same driver through
  # nvidia-smi and publishes the three fields `cluster` plots.
  - job_name: dcgm
    static_configs:
      - targets: ["127.0.0.1:9400"]
