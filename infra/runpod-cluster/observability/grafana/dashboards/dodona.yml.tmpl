# Load the dashboards from where they already live. A TEMPLATE: workers.sh
# renders __DASHBOARDS__ to the real path.
#
# This file must live in a `dashboards/` subdirectory of the provisioning
# directory. Grafana looks for <provisioning>/dashboards/*.yml and
# <provisioning>/datasources/*.yml — a flat `dashboards.yml` beside them is
# simply never read, with no error and no empty-state hint. Grafana starts
# fine, the datasource is missing, every panel is blank.
#
# `path` points into the Kubernetes tree on purpose. The ten JSONs are the
# dashboards for this project regardless of how the workers were started, and
# copying them here would create a second set to forget to update. The k8s path
# mounts the same directory as a ConfigMap; this one reads it off disk.
apiVersion: 1

providers:
  - name: dodona
    orgId: 1
    folder: Dodona
    type: file
    # false, or a dashboard removed from the directory stays in Grafana's
    # database for ever. Four Kubernetes dashboards survived the filter that
    # stopped provisioning them — Grafana had been told to keep what it already
    # had, and its db persists across restarts. The provisioning directory is
    # the source of truth; what is not in it should not be in Grafana.
    disableDeletion: false
    # Edits made in the UI are overwritten on restart. Deliberate: a dashboard
    # that only exists in someone's browser is not a dashboard this repo has.
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      # Rendered, not interpolated: relying on Grafana to expand an env var
      # here is one more thing that fails silently when it does not.
      path: __DASHBOARDS__
      foldersFromFilesStructure: false
