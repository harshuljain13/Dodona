{
  "uid": "class10-keda",
  "title": "Class 10 / KEDA",
  "tags": [
    "class10",
    "keda"
  ],
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
