          },
          "expr": "container_memory_working_set_bytes{container!=\"\",pod=~\"vllm-.*|orch-serve.*|mooncake-store.*|open-webui.*\"}",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
